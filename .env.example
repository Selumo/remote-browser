# PocketBase superuser used by the app server (PocketBase listens on 127.0.0.1 only)
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-to-a-long-password

# First dashboard login, created in the PocketBase users collection on start if missing
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# MCP bearer token (32+ random chars). Leave empty to allow only Cloudflare Access identities below
MCP_TOKEN=
# Comma separated emails trusted from the Cloudflare Access header cf-access-authenticated-user-email
ALLOWED_EMAILS=

# Set to false only for plain http local runs
COOKIE_SECURE=true

# Time zone for job cron schedules
SCHEDULE_TZ=Asia/Seoul
